{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "yourapp",
  "identifier": "com.yourapp.dev",
  "app": {
    "windows": [
      {
        "title": "yourapp",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["yourapp"]
      }
    }
  }
}
